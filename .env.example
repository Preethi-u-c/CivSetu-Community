# =============================================================================
# CivSetu-Community Environment Configuration
# =============================================================================

# 1. PostgreSQL Database Configuration
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=[require|disable]
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/civsetu_community

# 2. Authentication & Session Secret
# Generate a strong 32+ character secret string (e.g. openssl rand -base64 32)
AUTH_SECRET=your_super_secret_auth_session_key_min_32_chars

# 3. Twilio SMS Configuration (Required for live OTP SMS delivery)
# Obtain these from your Twilio Console: https://console.twilio.com/
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# 4. Application Environment
NODE_ENV=development

# 5. Local Development Administrator Credentials (LOCAL DEVELOPMENT ONLY)
# Configure your desired local development password for the 'admin' account here.
# During initial database seeding/startup, this password is securely bcrypt-hashed before storage.
# WARNING: This variable is for LOCAL DEVELOPMENT ONLY and must NEVER be used as a production secret.
# In production, use INITIAL_ADMIN_PASSWORD_HASH with a pre-hashed bcrypt value or manage admin credentials securely.
INITIAL_ADMIN_PASSWORD=your_local_dev_admin_password_here
